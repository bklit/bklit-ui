{
  "name": "bklit-ui",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:studio-docs": "pnpm --filter studio-docs dev",
    "lint": "biome check --no-errors-on-unmatched ./",
    "lint:fix": "biome check --write --no-errors-on-unmatched ./",
    "format": "biome check --write --no-errors-on-unmatched ./",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "husky",
    "registry:build": "pnpm --filter @bklitui/ui registry:build",
    "registry:verify": "node packages/ui/scripts/verify-registry-files.mjs && node packages/ui/scripts/verify-registry-deps.mjs && node packages/ui/scripts/verify-registry-sync.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.7.5",
    "typescript": "5.9.2",
    "ultracite": "7.0.12"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@central-icons-react/all"
    ],
    "overrides": {
      "esm-env": "npm:esm-env-runtime@^0.1.1"
    }
  }
}
